{
  "name": "T-Chat",
  "version": "1.0.0",
  "description": "Peer-to-peer terminal chat over WebSockets.",
  "author": "Aayush Sharma",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chat": "dist/index.js",
    "chat-server": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "server": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/server.js",
    "test": "tsx test/mesh.smoke.ts && tsx test/relay.smoke.ts"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "figlet": "^1.11.4",
    "ws": "^8.21.3"
  }
}
